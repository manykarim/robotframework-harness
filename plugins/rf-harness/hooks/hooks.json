{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S \"${CLAUDE_PLUGIN_ROOT}/bin/rfh-launch\" SessionStart --agent auto",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S \"${CLAUDE_PLUGIN_ROOT}/bin/rfh-launch\" UserPromptSubmit --agent auto",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S \"${CLAUDE_PLUGIN_ROOT}/bin/rfh-launch\" PreToolUse --agent auto",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S \"${CLAUDE_PLUGIN_ROOT}/bin/rfh-launch\" PostToolUse --agent auto",
            "timeout": 180
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S \"${CLAUDE_PLUGIN_ROOT}/bin/rfh-launch\" PostToolUseFailure --agent auto",
            "timeout": 180
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S \"${CLAUDE_PLUGIN_ROOT}/bin/rfh-launch\" Stop --agent auto",
            "timeout": 90
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S \"${CLAUDE_PLUGIN_ROOT}/bin/rfh-launch\" SessionEnd --agent auto",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
