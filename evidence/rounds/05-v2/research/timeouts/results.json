 "semantics": {
  "browser": {
   "Set Browser Timeout": "returns previous value ('10 seconds'); scope arg Global|Suite(default)|Test; Test scope reverts after the test, Global persists; affects every element wait (Click/Fill/Get Text/Wait For Elements State default) AND navigation (New Page, Go To). Close Browser/Context always get >=20 s.",
   "Library Browser timeout=": "same effect as Set Browser Timeout at import (2s import -> 2.1 s time-to-fail); .save copies it into *** Settings ***",
   "retry_assertions_for": "default 1 s; effective assertion retry = min(retry_assertions_for, browser timeout) (ra3s/bt10s 3.1 s, ra5s/bt2s 2.1 s, ra3s/bt1s 1.09 s) -> shortening timeout to 2 s does not change default assertion behaviour",
   "explicit timeout=": "Wait For Elements State timeout= and Go To timeout= override the browser timeout in both directions",
   "Get Element Count": "never waits (0.01 s) -> safe existence probe",
   "Get Elements": "waits the full timeout then PASSES with an empty list (10 s / 2 s / 1 s)",
   "Go To failure": "costs ~2x timeout with default run_on_failure (fail screenshot waits for the pending navigation): 2s timeout -> 4.02 s; run_on_failure=None -> 2.02 s; New Page failure 2.1 s",
   "screenshot overhead": "run_on_failure screenshot adds ~70-100 ms to a locator failure"
  },
  "selenium": {
   "Set Selenium Timeout": "returns old value ('5 seconds'); affects ONLY Wait Until* keywords (and explicit timeout= overrides); not Go To, not Click/Get Text",
   "Set Selenium Implicit Wait": "default 0; applies to EVERY element lookup: Click Element, Get Text, Element Text Should Be, Page Should Contain Element, Input Text, Get Element Count and even Page Should NOT Contain Element (passes only after the full implicit wait); adds to Wait Until* (t5s+iw2s -> 6.7 s; iw10s -> 10.2 s)",
   "Set Selenium Page Load Timeout": "separate (default 5 min); 2s -> Go To fails at 2.0 s with TimeoutException 'Timed out receiving message from renderer'",
   "no-wait keywords": "with implicit wait 0, Click Element/Get Text/Element Text Should Be fail in ~15 ms on a slow-but-valid element regardless of the Selenium timeout (a real test bug, not a REPL artefact)"
  }
 },
 "failure_message_regexes": {
  "browser_locator_timeout": "TimeoutError: locator\\.(\\w+): Timeout (\\d+)ms exceeded\\.\\s*\\n\\s*Call log:\\s*\\n\\s*- waiting for locator\\('(.+?)'\\)( to be (\\w+))?",
  "browser_navigation_timeout": "TimeoutError: page\\.goto: Timeout (\\d+)ms exceeded\\.[\\s\\S]*?navigating to \\\"([^\\\"]+)\\\", waiting until \\\"(\\w+)\\\"",
  "browser_navigation_aborted": "Error: page\\.goto: net::ERR_ABORTED at (\\S+)",
  "browser_waiting_navigation": "waiting for \\\"([^\\\"]+)\\\" navigation to finish",
  "browser_assertion": "^(Text|Title|Element count for selector `.+?` is|Url|Attribute) '.*' \\(\\w+\\) should (be|contain|not be|start with|end with|match)",
  "selenium_not_found": "^Element with locator '(.+)' not found\\.$",
  "selenium_wait_until": "^Element '(.+)' (not visible after|did not appear in) ([\\d.]+ \\w+)\\.$",
  "selenium_page_contains": "^Page should have contained element '(.+)' but did not\\.$",
  "selenium_page_load": "TimeoutException: Message: timeout: Timed out receiving message from renderer"
 },
 "leak": {
  "save_copies_agent_lines": "REPL .save keeps `Library    Browser    timeout=2s` in *** Settings *** and `Set Browser Timeout    3s` in the test (out/repl/saved_A.robot)",
  "listener_injection": "ROBOT_OPTIONS='--listener rfh_repl_timeouts.py:2s:5s' -> REPL shortened, .save output has plain `Library    Browser` (saved_B.robot); listener inactive under `robotcode robot`, `robotcode robot-debug` and plain `robot` (timeout_in_run=10 seconds in all three)"
 }
